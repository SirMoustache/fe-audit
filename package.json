{
  "name": "fe-audit",
  "version": "1.0.0",
  "description": "Classify npm audit findings and generate overrides that are safe to apply",
  "keywords": [
    "npm",
    "audit",
    "overrides",
    "vulnerabilities",
    "security",
    "lockfile",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SirMoustache/fe-audit.git"
  },
  "bugs": {
    "url": "https://github.com/SirMoustache/fe-audit/issues"
  },
  "homepage": "https://github.com/SirMoustache/fe-audit#readme",
  "type": "commonjs",
  "bin": {
    "fe-audit": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean": "node -e \"const fs=require('fs');for(const p of ['dist','.tmp-test','tsconfig.build.tsbuildinfo'])fs.rmSync(p,{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node .tmp-test/test/fe-audit.test.js",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build && changeset publish",
    "prepublishOnly": "npm run clean && npm run build && npm test"
  },
  "dependencies": {
    "semver": "^7.6.3"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@types/node": "^20.14.0",
    "@types/semver": "^7.5.8",
    "typescript": "^5.5.4"
  }
}
